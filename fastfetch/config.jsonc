
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color" : {
      "1" : "#FFC0CB",
      "2" : "green", 
      "3" : "blue",
    },
  },
  "display": {
      "separator": ": ",
  },
  "modules": [
    "title",
    "separator",
    {
        "type": "os",
        "key": "OS",
        "keyColor": "blue",
        "format": "{name} {version}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "memory",
    "battery",
    "poweradapter",
  ]
}
